#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// OS設定を日本語キーボードのままで使用するための変換定義（#defineに続いて、入力したい文字が左側、それに対応するUSキーボード上のキーが右側）

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

//AMLを延長する

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mkp_input_listener { input-processors = <&zip_temp_layer 4 250>; };

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <25 26>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 28>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 25>;
        };

        hanzenkaku {
            bindings = <&switch_hanzenkaku>;
            key-positions = <28 33>;
        };

        kagikakko1 {
            bindings = <&kp JP_LBRACKET>;
            key-positions = <34 20>;
        };

        kagikakko2 {
            bindings = <&kp JP_RBRACKET>;
            key-positions = <21 35>;
        };

        kakko1 {
            bindings = <&kp JP_LPAREN>;
            key-positions = <32 18>;
        };

        kakko2 {
            bindings = <&kp JP_RPAREN>;
            key-positions = <19 33>;
        };

        double_quotation {
            bindings = <&kp JP_DQUOTE>;
            key-positions = <21 20>;
        };

        quote {
            bindings = <&kp JP_QUOTE>;
            key-positions = <34 35>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <33 20>;
        };

        back-slash {
            bindings = <&kp JP_YEN>;
            key-positions = <19 34>;
        };

        UnderBar {
            bindings = <&kp JP_UNDERSCORE>;
            key-positions = <48 49>;
        };
    };

    macros {
        switch_hanzenkaku: switch_hanzenkaku {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SWITCH_HANZENKAKU";
        };

        windows_v: windows_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_WIN>;

            label = "WINDOWS_V";
        };

        copy_upper: copy_upper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(LEFT_ALT)>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LS(LEFT_ALT)>;

            label = "COPY_UPPER";
        };

        copy_lower: copy_lower {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(LEFT_ALT)>,
                <&macro_tap>,
                <&kp DOWN_ARROW>,
                <&macro_release>,
                <&kp LS(LEFT_ALT)>;

            label = "COPY_LOWER";
        };

        kagikakko2_macro: kagikakko2_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp JP_RBRACE>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "KAGIKAKKO2_MACRO";
        };

        mc60: mc60 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp NUMBER_6>,
                <&macro_tap>,
                <&kp NUMBER_0>,
                <&macro_tap>,
                <&kp NUMBER_6>,
                <&macro_tap>,
                <&kp NUMBER_7>;

            label = "MC60";
        };

        mc27: mc27 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp NUMBER_2>,
                <&macro_tap>,
                <&kp NUMBER_7>,
                <&macro_tap>,
                <&kp NUMBER_3>;

            label = "MC27";
        };

        mcTu: mcTu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp T>,
                <&macro_release>,
                <&macro_tap>,
                <&kp U>;

            label = "MCTU";
        };

        mc53: mc53 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp NUMBER_0>,
                <&macro_tap>,
                <&kp NUMBER_5>,
                <&macro_tap>,
                <&kp NUMBER_3>;

            label = "MC53";
        };

        mckagikakko1: mckagikakko1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp JP_LBRACE>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "MCKAGIKAKKO1";
        };

        mcAst: mcAst {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp NUMBER_8>,
                <&macro_release>,
                <&kp LSHFT>;

            label = "MCAST";
        };

        mcHs: mcHs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp HASH>;

            label = "MCHS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none  &none             &none     &none     &none               &none                                         &none      &none  &none      &none      &none         &none
&none  &kp Q             &kp W     &kp E     &kp R               &kp T                                         &kp Y      &kp U  &kp I      &kp O      &kp P         &none
&none  &kp A             &kp S     &kp D     &kp F               &kp G        &none             &none          &kp H      &kp J  &kp K      &kp L      &lt 3 JP_YEN  &none
&none  &mt LEFT_SHIFT Z  &kp X     &lt 1 C   &kp V               &kp B        &kp HASH          &kp MINUS      &kp N      &kp M  &kp COMMA  &kp DOT    &lt 5 COLON   &none
&none  &kp LCTRL         &kp LGUI  &kp LALT  &mt LEFT_SHIFT TAB  &lt 2 SPACE  &mt LCTRL DELETE  &kp BACKSPACE  &kp ENTER  &none  &none      &kp SLASH  &lt 6 JP_AT   &none
            >;

            label = "default";
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                             &trans           &trans            &trans            &trans            &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans                             &trans           &kp LS(NUMBER_2)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans             &kp JP_YEN       &kp SEMICOLON     &kp JP_COLON      &kp JP_LBRACE     &kp JP_RBRACE      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp JP_UNDERSCORE  &kp LS(AT_SIGN)  &kp SLASH         &kp JP_YEN        &kp JP_LBRACKET   &kp JP_RBRACKET    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp COMMA          &kp PERIOD       &trans            &trans            &kp JP_AT         &kp JP_UNDERSCORE  &trans
            >;

            label = "symbol";
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans        &trans    &trans      &trans                               &trans        &trans        &trans        &trans           &trans        &trans
&trans  &kp LS(EXCLAMATION)  &kp LS(QUESTION)  &kp LS(HASH)  &kp LS(DOLLAR)  &kp LS(JP_AMPERSAND)                     &kp LS(JP_EQUAL)  &kp LS(JP_PLUS)   &kp MINUS     &kp LS(JP_ASTERISK)  &kp SLASH     &trans
&trans  &kp N1           &kp N2        &kp N3    &kp N4      &kp N5            &trans  &trans     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9     &kp NUMBER_0  &trans
&trans  &kp F1           &kp F2        &kp F3    &kp F4      &kp F5            &trans  &trans     &kp F6        &kp F7        &kp F8        &kp F9           &kp F10       &trans
&trans  &trans           &trans        &trans    &trans      &trans            &trans  &kp COMMA  &kp PERIOD    &none         &trans        &kp F11          &kp F12       &trans
            >;

            label = "num";
        };

        layer_3 {
            bindings = <
&trans  &trans          &trans        &trans    &trans         &trans                      &trans     &trans     &trans        &trans     &trans  &trans
&trans  &kp ESCAPE      &none         &kp UP    &none          &trans                      &kp LC(Z)  &kp LC(Y)  &kp LC(F)     &kp LC(H)  &trans  &trans
&trans  &kp HOME        &kp LEFT      &kp DOWN  &kp RIGHT      &kp END  &trans  &trans     &kp LC(A)  &kp DOWN   &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LEFT)  &trans    &kp LG(RIGHT)  &trans   &trans  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans        &trans     &trans  &trans
&trans  &trans          &trans        &trans    &kp DELETE     &kp TAB  &trans  &trans     &trans     &trans     &trans        &trans     &trans  &trans
            >;

            label = "arrow";
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;

            label = "mouse";
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &mkp MB4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans    &trans
            >;

            label = "scroll";
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &mcHs   &mcTu   &mc27   &mc53   &mc60         &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
